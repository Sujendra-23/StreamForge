{
  "name": "streamforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "go run ./cmd/streamforge",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "go run ./cmd/streamforge",
    "test": "vitest run && go test ./...",
    "test:e2e": "playwright test",
    "check": "tsc -p web/tsconfig.json && go vet ./...",
    "build:native": "bash scripts/build-native.sh",
    "native": "bash scripts/native.sh",
    "test:native": "SF_NATIVE_E2E=1 playwright test tests/native.spec.ts",
    "test:load": "SF_NATIVE_E2E=1 SF_LOAD_E2E=1 playwright test tests/native.spec.ts",
    "test:a11y": "node scripts/a11y.mjs",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css}\" \"tests/*.ts\" scripts/*.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
