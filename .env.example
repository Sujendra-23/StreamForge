# Copy to .env for docker compose. For local Go processes, export these variables.
ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173,localhost:8080,127.0.0.1:8080
# Configure when reaching peers across networks:
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:YOUR_PUBLIC_IP:3478?transport=udp
# TURN_SECRET=generate-a-random-secret
# RTC_PUBLIC_IP=YOUR_PUBLIC_IP
# RTC_UDP_MIN=50000
# RTC_UDP_MAX=50050
GRAFANA_PASSWORD=streamforge-local
